# 复制本文件为 .env 后填入真实值。
# .env 已被 .gitignore 忽略，不会提交到 Git（.env.example 这个模板除外）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
# JJWT 要求 HMAC-SHA 密钥 >= 32 字节（256 位），太短会在启动时抛 WeakKeyException
JWT_SECRET=hospital-registration-system-jwt-secret-key-change-me-in-production-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 本地开发连接参数（后端启动时自动读取本文件，无需手动 export 环境变量）。
# 本机 3306 / 6379 常被原生 MySQL/Redis 占用，所以指向 compose 映射的 3307 / 6380；
# 如果你本地直接跑数据库、端口就是 3306/6379，改成对应值即可。
# compose 里的 app 容器用自己的 3306/6379，不读这几行。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DB=hospital
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=

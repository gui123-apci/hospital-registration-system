# 复制本文件为 .env 后填入真实值。
# .env 已被 .gitignore 忽略，不会提交到 Git（.env.example 这个模板除外）。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
# JJWT 要求 HMAC-SHA 密钥 >= 32 字节（256 位），太短会在启动时抛 WeakKeyException
JWT_SECRET=hospital-registration-system-jwt-secret-key-change-me-in-production-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
